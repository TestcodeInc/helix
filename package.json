{
  "name": "helix-mcp",
  "version": "0.6.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Helix — remote MCP server with self-issued OAuth. A portable, user-owned context vault any AI app can read with permission.",
  "type": "module",
  "scripts": {
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/app.ts --bundle --format=esm --platform=neutral --outfile=/tmp/helix-app.mjs && node uxtest.mjs",
    "publish-open": "node scripts/publish-open.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.17.4",
    "hono": "^4.12.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260719.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.112.0"
  }
}
